<!-- STATS -->
<div class="stats-bar">
  <div class="stat-item reveal"><div class="num" data-target="500" data-suffix="+">0</div><div class="lbl">SATISFIED CUSTOMERS</div></div>
  <div class="stat-item reveal" style="transition-delay:.1s"><div class="num" data-target="8" data-suffix="+">0</div><div class="lbl">YEARS IN BUSINESS</div></div>
  <div class="stat-item reveal" style="transition-delay:.2s"><div class="num" data-target="20" data-suffix="+">0</div><div class="lbl">PRODUCT VARIETIES</div></div>
  <div class="stat-item reveal" style="transition-delay:.3s"><div class="num" data-target="100" data-suffix="%">0</div><div class="lbl">CUSTOM ORDERS ACCEPTED</div></div>
</div>

<!-- FEATURED PRODUCTS -->
<section id="products" style="background:var(--black)">
  <div class="products-header">
    <div>
      <div class="section-label reveal">Our Products</div>
      <h2 class="section-title reveal">Trolleys &amp; Furniture<br/>Built to Last</h2>
    </div>
    <div style="display:flex;align-items:flex-end;gap:1rem;flex-wrap:wrap">
      <a href="/products" class="btn-outline reveal">View All Products →</a>
    </div>
  </div>
  <div class="product-grid">
    <% products.slice(0,6).forEach((p, i) => { %>
    <div class="product-card reveal" style="transition-delay:<%= i*0.08 %>s">
      <div class="product-img">
        <%= p.emoji %>
        <div class="shine"></div>
        <% if(p.tag) { %><div class="p-tag"><%= p.tag %></div><% } %>
        <div class="p-cat"><%= p.category.toUpperCase() %></div>
      </div>
      <div class="product-body">
        <div class="product-name"><%= p.name %></div>
        <p class="product-desc"><%= p.desc %></p>
        <div class="product-features">
          <% p.features.forEach(f => { %><span class="feat-chip"><%= f %></span><% }) %>
        </div>
        <button class="product-enquire" onclick="enquireProduct('<%= p.name %>')">Enquire Now →</button>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- WHY US -->
<section id="why">
  <div class="why-grid">
    <div>
      <div class="section-label reveal-l">Why Choose Us</div>
      <h2 class="section-title reveal-l">Quality You Can<br/>See and Feel</h2>
      <p class="section-sub reveal-l">Every trolley and furniture piece from Aqsa Kitchen's goes through strict quality checks before delivery. Trusted by 500+ families across Maharashtra.</p>
      <div class="why-list">
        <div class="why-item reveal-l" style="transition-delay:.1s"><div class="why-icon">⚙️</div><div class="why-text"><h3>Food-Grade Stainless Steel</h3><p>SS 304 grade material — same as used in professional restaurant kitchens. Safe, hygienic, and long-lasting.</p></div></div>
        <div class="why-item reveal-l" style="transition-delay:.2s"><div class="why-icon">📐</div><div class="why-text"><h3>100% Custom Sizing</h3><p>Every order is made to your exact dimensions. Small studio kitchen or large commercial setup — we build for your space.</p></div></div>
        <div class="why-item reveal-l" style="transition-delay:.3s"><div class="why-icon">🚚</div><div class="why-text"><h3>Pan-India Delivery</h3><p>We deliver safely packed to your doorstep anywhere in India. Easy assembly with included hardware kit.</p></div></div>
        <div class="why-item reveal-l" style="transition-delay:.4s"><div class="why-icon">🛡️</div><div class="why-text"><h3>1-Year Warranty</h3><p>All products come with a 12-month warranty on welds and structural integrity. No questions asked.</p></div></div>
      </div>
    </div>
    <div class="why-visual reveal-r">
      <div class="why-bg-num">8+</div>
      <div class="why-cards">
        <div class="why-card"><div class="wc-lbl">CUSTOMER SATISFACTION</div><div class="wc-val">97%</div><div class="wc-bar"><div class="wc-fill" style="width:97%"></div></div></div>
        <div class="why-card"><div class="wc-lbl">ON-TIME DELIVERY</div><div class="wc-val">94%</div><div class="wc-bar"><div class="wc-fill" style="width:94%"></div></div></div>
        <div class="why-card"><div class="wc-lbl">REPEAT CUSTOMERS</div><div class="wc-val">68%</div><div class="wc-bar"><div class="wc-fill" style="width:68%"></div></div></div>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section id="process">
  <div class="process-header">
    <div class="section-label reveal" style="justify-content:center">How It Works</div>
    <h2 class="section-title reveal">Order in 4 Simple Steps</h2>
    <p class="section-sub reveal" style="margin:0 auto;text-align:center">From enquiry to delivery — your custom piece in just a few days.</p>
  </div>
  <div class="process-steps">
    <div class="process-step reveal"><div class="step-num">1</div><div class="step-icon">💬</div><div class="step-title">Send Enquiry</div><p class="step-desc">Fill the contact form or WhatsApp us with your requirement.</p></div>
    <div class="process-step reveal" style="transition-delay:.15s"><div class="step-num">2</div><div class="step-icon">📋</div><div class="step-title">Get Quotation</div><p class="step-desc">Receive a detailed quote within 24 hours with full breakdown.</p></div>
    <div class="process-step reveal" style="transition-delay:.3s"><div class="step-num">3</div><div class="step-icon">🔨</div><div class="step-title">Manufacturing</div><p class="step-desc">Your order is hand-crafted in 5–7 business days with QC checks.</p></div>
    <div class="process-step reveal" style="transition-delay:.45s"><div class="step-num">4</div><div class="step-icon">🚚</div><div class="step-title">Delivery</div><p class="step-desc">Safely packed and delivered anywhere in India with assembly support.</p></div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section style="background:var(--black)">
  <div style="text-align:center">
    <div class="section-label reveal" style="justify-content:center">Customer Reviews</div>
    <h2 class="section-title reveal">What Our Customers Say</h2>
  </div>
  <div class="testi-grid">
    <% testimonials.forEach((t, i) => { %>
    <div class="testi-card reveal" style="transition-delay:<%= i*0.1 %>s">
      <div class="testi-stars"><%= '★'.repeat(t.stars) %></div>
      <p class="testi-text">"<%= t.text %>"</p>
      <div class="testi-author">
        <div class="testi-avatar"><%= t.avatar %></div>
        <div><div class="testi-name"><%= t.name %></div><div class="testi-loc"><%= t.role %></div></div>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- CTA BANNER -->
<section style="background:linear-gradient(135deg,rgba(200,151,58,.12),rgba(200,151,58,.04));border-top:1px solid var(--border);border-bottom:1px solid var(--border);text-align:center;padding:4rem 5%">
  <div class="section-label reveal" style="justify-content:center">Ready to Order?</div>
  <h2 class="section-title reveal" style="max-width:500px;margin:0 auto .8rem">Get Your Custom Kitchen Trolley Today</h2>
  <p class="section-sub reveal" style="margin:.8rem auto 2rem;text-align:center">Free quote within 24 hours. Custom sizes available. Pan-India delivery.</p>
  <div class="reveal" style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
    <a href="/contact" class="btn-primary">Get Free Quote</a>
    <a href="/products" class="btn-outline">Browse Products</a>
  </div>
</section>

<%- include('partials/footer') %>

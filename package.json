{
  "name": "aqsa-kitchens",
  "version": "1.0.0",
  "description": "Aqsa Kitchen's - Premium Kitchen Trolley & Furniture Website",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --forceExit --coverage",
    "test:ci": "jest --forceExit --ci --coverage --coverageReporters=text --coverageReporters=lcov"
